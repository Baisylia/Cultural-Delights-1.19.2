{
  "multipart": [
    {
      "when": { "age": 0 },
      "apply": { "model": "culturaldelights:block/rope_beans_stage0" }
    },
    {
      "when": { "age": 1 },
      "apply": { "model": "culturaldelights:block/rope_beans_stage1" }
    },
    {
      "when": { "age": 2 },
      "apply": { "model": "culturaldelights:block/rope_beans_stage2" }
    },
    {
      "when": { "age": 3 },
      "apply": { "model": "culturaldelights:block/rope_beans_stage3" }
    },
    {
      "when": { "knot": true },
      "apply": { "model": "supplementaries:block/rope_knot" }
    },
    {
      "when": { "north": true },
      "apply": { "model": "supplementaries:block/rope_connection" }
    },
    {
      "when": { "east": true },
      "apply": { "model": "supplementaries:block/rope_connection", "y": 90 }
    },
    {
      "when": { "south": true },
      "apply": { "model": "supplementaries:block/rope_connection", "y": 180 }
    },
    {
      "when": { "west": true },
      "apply": { "model": "supplementaries:block/rope_connection", "y": 270 }
    }
  ]
}
